/* 你的课程表 · 全局样式
   主色采用蓝色系：多国色彩偏好调研中蓝色稳居第一（YouGov 十国调查；2023 全球 56 国 12 万人调查中 42% 首选蓝色，
   中国市场 Edelman 2023 亦为蓝 32% > 红 25% > 绿）。蓝色在学习类工具里也更利于专注与信任感。
   浅色主题：所有面板为浅底深字，状态栏 / 胶囊 / 导航栏由微信原生导航栏托管，页面内容不进入这些区域。 */
page {
    --primary: #2f6bed;
    --primary-strong: #1e55d6;
    --primary-soft: #eaf1ff;
    --bg: #f5f7fb;
    --surface: #ffffff;
    --text: #1b2437;
    --text-2: #5a6478;
    --muted: #8a94a6;
    --line: #e8ecf3;
    --danger: #d95050;
    min-height: 100%;
    background: #f5f7fb;
    color: #1b2437;
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
    font-size: 28rpx;
    -webkit-font-smoothing: antialiased;
}

view, text, button, input, textarea, scroll-view {
    box-sizing: border-box;
}

button {
    border-radius: 16rpx;
    font-size: 28rpx;
    line-height: 1.5;
}

button::after {
    border: none;
}

/* 页面容器：底部预留安全区，底色铺满；tabBar 页面由原生 tabBar 处理安全区 */
.page {
    min-height: 100vh;
    padding: 24rpx 24rpx 48rpx;
    background: #f5f7fb;
}

.page-safe {
    padding-bottom: calc(48rpx + constant(safe-area-inset-bottom));
    padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.card {
    background: #ffffff;
    border: 2rpx solid #e8ecf3;
    border-radius: 24rpx;
    padding: 28rpx;
    margin-bottom: 24rpx;
}

.card-flat {
    background: #ffffff;
    border-radius: 24rpx;
    padding: 24rpx 28rpx;
    margin-bottom: 20rpx;
}

.section-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #1b2437;
}

.section-sub {
    margin-top: 8rpx;
    font-size: 24rpx;
    color: #8a94a6;
    line-height: 1.6;
}

.muted {
    color: #8a94a6;
}

.text-2 {
    color: #5a6478;
}

.row {
    display: flex;
    align-items: center;
}

.row-between {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.grow {
    flex: 1;
    min-width: 0;
}

.divider {
    height: 2rpx;
    background: #e8ecf3;
    margin: 20rpx 0;
}

/* 分段控件 */
.seg {
    display: flex;
    background: #eef2f9;
    border-radius: 999rpx;
    padding: 6rpx;
}

.seg-item {
    flex: 1;
    text-align: center;
    padding: 12rpx 0;
    font-size: 26rpx;
    color: #5a6478;
    border-radius: 999rpx;
}

.seg-item-active {
    background: #ffffff;
    color: #2f6bed;
    font-weight: 600;
    box-shadow: 0 2rpx 10rpx rgba(31, 55, 102, 0.08);
}

/* 标签 */
.chip {
    display: inline-flex;
    align-items: center;
    padding: 8rpx 20rpx;
    border-radius: 999rpx;
    background: #f0f3f9;
    color: #5a6478;
    font-size: 24rpx;
}

.chip-active {
    background: #eaf1ff;
    color: #2f6bed;
    font-weight: 600;
}

.tag {
    display: inline-block;
    padding: 4rpx 12rpx;
    border-radius: 8rpx;
    background: #eaf1ff;
    color: #2f6bed;
    font-size: 20rpx;
}

/* 按钮 */
.primary-btn {
    background: #2f6bed;
    color: #ffffff;
    font-weight: 600;
    border: none;
}

.primary-btn[disabled] {
    background: #a9c0f2;
    color: #ffffff;
}

.ghost-btn {
    background: #eaf1ff;
    color: #2f6bed;
    font-weight: 600;
    border: none;
}

.plain-btn {
    background: #f2f5fa;
    color: #5a6478;
    border: none;
}

.danger-btn {
    background: #fff0f0;
    color: #d95050;
    border: none;
}

/* 表单 */
.field {
    margin-bottom: 24rpx;
}

.field-label {
    display: block;
    font-size: 26rpx;
    color: #5a6478;
    margin-bottom: 12rpx;
}

.input {
    width: 100%;
    min-height: 84rpx;
    padding: 18rpx 22rpx;
    background: #f7f9fd;
    border: 2rpx solid #e8ecf3;
    border-radius: 16rpx;
    color: #1b2437;
    font-size: 28rpx;
}

.textarea {
    width: 100%;
    min-height: 180rpx;
    padding: 18rpx 22rpx;
    background: #f7f9fd;
    border: 2rpx solid #e8ecf3;
    border-radius: 16rpx;
    color: #1b2437;
    font-size: 28rpx;
    line-height: 1.6;
}

.input-placeholder {
    color: #aeb7c6;
}

/* 状态 */
.loading-box,
.empty-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 90rpx 32rpx;
    text-align: center;
}

.spinner {
    width: 48rpx;
    height: 48rpx;
    border: 6rpx solid #dde8ff;
    border-top-color: #2f6bed;
    border-radius: 50%;
    animation: wb-spin 0.8s linear infinite;
}

@keyframes wb-spin {
    to { transform: rotate(360deg); }
}

.empty-icon {
    width: 96rpx;
    height: 96rpx;
    line-height: 96rpx;
    text-align: center;
    border-radius: 32rpx;
    background: #eaf1ff;
    color: #2f6bed;
    font-size: 46rpx;
    margin-bottom: 24rpx;
}

.empty-title {
    font-size: 30rpx;
    font-weight: 600;
}

.empty-desc {
    margin-top: 10rpx;
    font-size: 25rpx;
    color: #8a94a6;
    line-height: 1.6;
}

/* 底部固定操作条，避开 Home Indicator 安全区 */
.bottom-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 20rpx 24rpx;
    padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
    padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
    background: #ffffff;
    border-top: 2rpx solid #e8ecf3;
    z-index: 20;
}

.bottom-bar-spacer {
    height: calc(140rpx + constant(safe-area-inset-bottom));
    height: calc(140rpx + env(safe-area-inset-bottom));
}
