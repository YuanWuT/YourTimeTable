.login-card {
    margin: 40rpx 8rpx;
    padding: 48rpx 40rpx 40rpx;
    background: #ffffff;
    border: 2rpx solid #e8ecf3;
    border-radius: 32rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: 0 12rpx 40rpx rgba(31, 55, 102, 0.06);
}

.login-logo {
    width: 112rpx;
    height: 112rpx;
    border-radius: 32rpx;
    background: #2f6bed;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 28rpx;
}

.login-logo-text {
    color: #ffffff;
    font-size: 54rpx;
    font-weight: 700;
}

.login-title {
    font-size: 36rpx;
    font-weight: 700;
    color: #1b2437;
}

.login-desc {
    margin-top: 16rpx;
    font-size: 26rpx;
    line-height: 1.7;
    color: #5a6478;
    text-align: center;
}

.login-points {
    width: 100%;
    margin: 32rpx 0 36rpx;
    padding: 24rpx 26rpx;
    background: #f7f9fd;
    border-radius: 20rpx;
}

.login-point {
    display: flex;
    align-items: center;
    font-size: 25rpx;
    color: #5a6478;
    line-height: 2;
}

.login-point-dot {
    width: 12rpx;
    height: 12rpx;
    border-radius: 50%;
    background: #2f6bed;
    margin-right: 16rpx;
}

.login-button {
    width: 100%;
    height: 92rpx;
    line-height: 92rpx;
    padding: 0;
}

.login-demo {
    width: 100%;
    margin-top: 20rpx;
    background: transparent;
    color: #2f6bed;
    font-size: 26rpx;
}

.login-error {
    margin-top: 24rpx;
    padding: 20rpx 24rpx;
    width: 100%;
    background: #fff4f2;
    border-radius: 16rpx;
    color: #c0573d;
    font-size: 24rpx;
    line-height: 1.6;
}
