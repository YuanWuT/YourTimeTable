.error-card {
    padding: 24rpx 26rpx;
    margin-bottom: 20rpx;
    background: #fff3f1;
    border: 2rpx solid #ffd9d2;
    border-radius: 20rpx;
}

.error-desc {
    font-size: 26rpx;
    color: #b94c37;
    line-height: 1.6;
}

.retry-btn {
    margin-top: 18rpx;
    width: 180rpx;
}

.scope-role-btn {
    margin-top: 24rpx;
}

.scope-count {
    display: block;
    margin-top: 16rpx;
    font-size: 24rpx;
    color: #2f6bed;
}

.scope-empty {
    padding: 70rpx 32rpx;
    background: #ffffff;
    border: 2rpx solid #e8ecf3;
    border-radius: 24rpx;
    margin-bottom: 24rpx;
}

.scope-item {
    position: relative;
}

.scope-item-active {
    border-color: #b9cdfb;
    background: #fbfdff;
}

.scope-item-icon {
    font-size: 46rpx;
    margin-right: 22rpx;
}

.scope-item-name {
    font-size: 30rpx;
    font-weight: 600;
    color: #1b2437;
}

.scope-gender-tag,
.scope-current-tag {
    margin-left: 16rpx;
}

.scope-item-meta {
    display: block;
    margin-top: 6rpx;
    font-size: 24rpx;
    color: #5a6478;
}

.scope-item-actions {
    display: flex;
    justify-content: flex-end;
    gap: 40rpx;
    margin-top: 20rpx;
    padding-top: 18rpx;
    border-top: 2rpx solid #e8ecf3;
}

.scope-link {
    font-size: 26rpx;
    color: #2f6bed;
    font-weight: 600;
}

.scope-link-danger {
    font-size: 26rpx;
    color: #d95050;
}

.scope-legacy-tip {
    padding: 20rpx 24rpx;
    margin-bottom: 24rpx;
    background: #f0f4fb;
    border-radius: 16rpx;
    font-size: 23rpx;
    color: #5a6478;
    line-height: 1.7;
}

/* 男孩 / 女孩 */
.gender-row {
    display: flex;
    gap: 20rpx;
}

.gender-option {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12rpx;
    min-height: 84rpx;
    padding: 14rpx 16rpx;
    background: #f7f9fd;
    border: 2rpx solid #e8ecf3;
    border-radius: 16rpx;
}

.gender-option-active {
    background: #eaf1ff;
    border-color: #2f6bed;
    color: #2f6bed;
    font-weight: 600;
}

.gender-icon {
    font-size: 40rpx;
}

.gender-name {
    font-size: 27rpx;
}

/* 底部弹层 */
.sheet-mask {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background: rgba(20, 30, 50, 0.42);
    z-index: 30;
}

.editor-sheet {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    max-height: 84vh;
    padding: 20rpx 28rpx;
    padding-bottom: calc(28rpx + constant(safe-area-inset-bottom));
    padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
    background: #ffffff;
    border-radius: 32rpx 32rpx 0 0;
    z-index: 31;
    display: flex;
    flex-direction: column;
}

.sheet-handle {
    width: 72rpx;
    height: 8rpx;
    border-radius: 8rpx;
    background: #dfe4ee;
    align-self: center;
    margin-bottom: 20rpx;
}

/* 表单区域吃掉剩余高度，底部两枚按钮始终留在屏幕内不被裁切 */
.editor-body {
    flex: 1;
    min-height: 0;
    max-height: 56vh;
    margin-top: 20rpx;
}

.editor-actions {
    gap: 20rpx;
    margin-top: 12rpx;
    flex-shrink: 0;
}

/* 原生 button 在不同宿主里的默认 padding / line-height 会把文字挤偏，
   这里用 flex 明确把「取消 / 保存」的文字摆到水平与垂直正中。 */
.editor-actions button {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 88rpx;
    line-height: 1;
    padding: 0;
    margin: 0;
    text-align: center;
}
