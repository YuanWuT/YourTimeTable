<view class="page index-page">
    <!-- 状态栏、胶囊按钮、44px 导航栏全部交给微信原生导航栏；页面内容从导航栏下方开始，不占用胶囊与安全区 -->
    <block wx:if="{{authState === 'checking' && !demoMode}}">
        <view class="loading-box">
            <view class="spinner"></view>
            <text class="empty-desc">正在连接云端课表…</text>
        </view>
    </block>

    <block wx:elif="{{authState === 'signed-out' && !demoMode}}">
        <login-panel title="登录后查看我的课程表" bind:signedin="onSignedIn" bind:demo="useDemo" />
    </block>

    <block wx:else>
        <view wx:if="{{demoMode}}" class="demo-banner" bindtap="showLogin">
            <view class="grow">
                <text class="demo-banner-title">示例课表</text>
                <text class="demo-banner-desc">仅用于预览界面，登录后查看你自己的课表</text>
            </view>
            <text class="demo-banner-action">微信登录 ›</text>
        </view>

        <view wx:if="{{errorText}}" class="error-card">
            <text class="error-title">暂时没能加载课表</text>
            <text class="error-desc">{{errorText}}</text>
            <button class="ghost-btn retry-btn" bindtap="onRetry">重新加载</button>
        </view>

        <view wx:elif="{{loading}}" class="loading-box">
            <view class="spinner"></view>
            <text class="empty-desc">正在同步课程表…</text>
        </view>

        <block wx:else>
            <!-- 身份 + 视图切换 -->
            <view class="header-card">
                <view class="header-top">
                    <view class="role-chip" bindtap="openRolePicker">
                        <text class="role-icon">{{roleIcon}}</text>
                        <text class="role-name">{{roleName}}</text>
                        <text class="role-caret">▾</text>
                    </view>
                    <view class="seg header-seg">
                        <view class="seg-item {{viewMode === 'week' ? 'seg-item-active' : ''}}" data-mode="week" bindtap="switchView">周视图</view>
                        <view class="seg-item {{viewMode === 'month' ? 'seg-item-active' : ''}}" data-mode="month" bindtap="switchView">月视图</view>
                    </view>
                </view>

                <view class="week-nav">
                    <view class="nav-arrow" data-step="-1" bindtap="changeWeek">‹</view>
                    <view class="week-mid" bindtap="goToday">
                        <text class="week-label">{{weekLabel}}</text>
                        <text class="week-range">{{dateRange}} · 点此回本周</text>
                    </view>
                    <view class="nav-arrow" data-step="1" bindtap="changeWeek">›</view>
                </view>

                <view wx:if="{{viewMode === 'week'}}" class="parity-row">
                    <text class="parity-label">显示</text>
                    <view class="chip {{parityMode === 'odd' ? 'chip-active' : ''}}" data-mode="odd" bindtap="chooseParity">单周</view>
                    <view class="chip {{parityMode === 'even' ? 'chip-active' : ''}}" data-mode="even" bindtap="chooseParity">双周</view>
                    <view class="chip {{parityMode === 'all' ? 'chip-active' : ''}}" data-mode="all" bindtap="chooseParity">全部</view>
                </view>
            </view>

            <!-- 下一节课 -->
            <view wx:if="{{nextCourse}}" class="next-card">
                <view class="next-left">
                    <text class="next-kicker">下一节课 · {{nextCourse.when}}</text>
                    <text class="next-title">{{nextCourse.title}}</text>
                    <text class="next-meta">{{nextCourse.timeText}} · {{nextCourse.locationText}}</text>
                    <text wx:if="{{nextCourse.teacherText}}" class="next-extra">老师 · {{nextCourse.teacherText}}</text>
                    <text wx:if="{{nextCourse.noteText}}" class="next-extra">备注 · {{nextCourse.noteText}}</text>
                </view>
                <view class="next-right">
                    <text class="next-count">{{nextCourse.countdown}}</text>
                </view>
            </view>

            <!-- 周视图 -->
            <block wx:if="{{viewMode === 'week'}}">
                <view wx:if="{{courseCount === 0}}" class="empty-card">
                    <view class="empty-icon">＋</view>
                    <text class="empty-title">还没有课程</text>
                    <text class="empty-desc">去「录入」页手动添加、拍照识别，或上传 Excel 表格</text>
                    <button class="ghost-btn empty-btn" bindtap="onAdd">添加第一节课</button>
                </view>

                <block wx:else>
                    <view class="batch-bar">
                        <block wx:if="{{!batchMode}}">
                            <text class="batch-hint">长按课程卡片可批量勾选</text>
                            <view class="batch-entry" bindtap="toggleBatchMode">批量删除</view>
                        </block>
                        <block wx:else>
                            <text class="batch-count">已选 {{selectedCount}} 节</text>
                            <view class="batch-actions">
                                <text class="batch-link" bindtap="selectAllBatch">全选</text>
                                <text class="batch-link" bindtap="exitBatchMode">取消</text>
                                <text class="batch-danger {{selectedCount === 0 ? 'batch-disabled' : ''}}"
                                      bindtap="confirmBatchRemove">删除选中</text>
                            </view>
                        </block>
                    </view>

                    <scroll-view wx:if="{{batchMode}}" class="day-tabs-scroll" scroll-x="true">
                        <view class="day-tabs">
                            <view wx:for="{{dayTabs}}" wx:key="index" class="day-tab"
                                  data-index="{{item.index}}" bindtap="jumpToDay">
                                <text class="day-tab-name">{{item.name}}</text>
                                <text class="day-tab-count">{{item.count}} 节</text>
                            </view>
                        </view>
                    </scroll-view>

                    <view class="grid-card">
                        <view class="time-rail">
                        <view class="rail-head"><text>时间</text></view>
                        <view wx:for="{{timeRail}}" wx:key="sort_no" class="rail-row">
                            <text class="rail-label">{{item.label}}</text>
                            <text class="rail-time">{{item.start_time}}</text>
                            <text class="rail-time">{{item.end_time}}</text>
                        </view>
                    </view>
                    <scroll-view class="days-scroll" scroll-x="true" scroll-into-view="{{scrollIntoId}}">
                        <view class="days-inner">
                            <view wx:for="{{weekColumns}}" wx:key="key" id="{{item.id}}" class="day-col">
                                <view class="day-head {{item.isToday ? 'day-head-today' : ''}}">
                                    <text class="day-name">{{item.dayName}}</text>
                                    <text class="day-date">{{item.dateLabel}}</text>
                                </view>
                                <view wx:for="{{item.cells}}" wx:for-item="cell" wx:key="key" class="grid-cell"
                                      data-day="{{cell.day}}" data-period="{{cell.periodNo}}" bindtap="onCellTap">
                                    <view wx:for="{{cell.courses}}" wx:for-item="course" wx:key="id"
                                          class="course-chip {{course.checked ? 'course-chip-checked' : ''}}"
                                          style="background:{{course.bg}};color:{{course.fg}};border-left:6rpx solid {{course.solid}}"
                                          data-id="{{course.id}}" data-day="{{course.day_of_week}}"
                                          catchtap="onCourseTap" bindlongpress="onCourseLongPress">
                                        <view wx:if="{{batchMode}}" class="chip-check {{course.checked ? 'chip-check-on' : ''}}">
                                            <text wx:if="{{course.checked}}">✓</text>
                                        </view>
                                        <text class="chip-title">{{course.title}}</text>
                                        <text class="chip-time">{{course.chipTimeText}}</text>
                                        <text class="chip-place">{{course.locationText}}</text>
                                        <text wx:if="{{course.chipExtraText}}" class="chip-extra">{{course.chipExtraText}}</text>
                                    </view>
                                </view>
                            </view>
                        </view>
                    </scroll-view>
                </view>
                </block>
                <view class="grid-tip">{{batchMode ? '点卡片勾选或取消 · 点上方星期可直接跳到那一天' : '本周共 ' + weekTotal + ' 节课 · 点空格子添加、长按课程批量管理'}}</view>
            </block>

            <!-- 月视图 -->
            <block wx:else>
                <view class="month-card">
                    <view class="month-nav">
                        <view class="nav-arrow" data-step="-1" bindtap="changeMonth">‹</view>
                        <text class="month-title">{{monthTitle}}</text>
                        <view class="nav-arrow" data-step="1" bindtap="changeMonth">›</view>
                        <text class="month-today" bindtap="goToday">今天</text>
                    </view>
                    <view class="month-heads">
                        <text wx:for="{{monthHeads}}" wx:key="*this" class="month-head">{{item}}</text>
                    </view>
                    <view class="month-grid">
                        <view wx:for="{{monthCells}}" wx:key="key"
                              class="month-cell {{item.inMonth ? '' : 'month-cell-out'}} {{item.isToday ? 'month-cell-today' : ''}}"
                              data-key="{{item.key}}" bindtap="onDayTap">
                            <text class="month-day">{{item.dayNumber}}</text>
                            <text class="month-parity">{{item.parityText}}</text>
                            <view class="month-dots">
                                <view wx:for="{{item.dots}}" wx:for-item="dot" wx:key="id" class="month-dot" style="background:{{dot.color}}"></view>
                            </view>
                            <text wx:if="{{item.count > 0}}" class="month-count">{{item.count}} 节</text>
                        </view>
                    </view>
                    <text class="month-tip">按开学第一周推算每天的单 / 双周 · 点日期查看当天实际课程</text>
                </view>
            </block>
        </block>

        <view wx:if="{{!batchMode}}" class="fab" bindtap="onAdd"><text class="fab-text">＋</text></view>
    </block>

    <!-- 当天课程抽屉 -->
    <view wx:if="{{showDaySheet}}" class="sheet-mask" bindtap="closeDaySheet"></view>
    <view wx:if="{{showDaySheet}}" class="day-sheet" catchtap="noop">
        <view class="sheet-handle"></view>
        <view class="row-between">
            <text class="section-title">{{selectedDayLabel}}</text>
            <text class="sheet-close" bindtap="closeDaySheet">关闭</text>
        </view>
        <scroll-view scroll-y class="sheet-list">
            <view wx:for="{{selectedDayCourses}}" wx:key="id" class="sheet-item" style="border-left:8rpx solid {{item.solid}}"
                  data-id="{{item.id}}" bindtap="onSheetCourseTap">
                <view class="row-between">
                    <text class="sheet-title">{{item.title}}</text>
                    <text class="sheet-time">{{item.timeText}}</text>
                </view>
                <text class="sheet-meta">{{item.locationText}}</text>
                <text wx:if="{{item.teacherText}}" class="sheet-meta">老师 · {{item.teacherText}}</text>
                <text wx:if="{{item.noteText}}" class="sheet-meta">备注 · {{item.noteText}}</text>
                <text wx:if="{{item.weekText !== '每周'}}" class="tag sheet-tag">{{item.weekText}}</text>
            </view>
            <view wx:if="{{selectedDayCourses.length === 0}}" class="empty-box">
                <text class="empty-title">这天没有课</text>
                <text class="empty-desc">好好休息一下</text>
            </view>
        </scroll-view>
    </view>

    <!-- 身份切换 -->
    <view wx:if="{{showRolePicker}}" class="sheet-mask" bindtap="closeRolePicker"></view>
    <view wx:if="{{showRolePicker}}" class="role-sheet" catchtap="noop">
        <view class="sheet-handle"></view>
        <text class="section-title">切换使用身份</text>
        <text class="section-sub">学生 / 家长 / 老师各有一份独立课表，切换后自动加载对应课程</text>
        <view wx:for="{{roleOptions}}" wx:key="key" class="role-option {{item.selected ? 'role-option-selected' : ''}}"
              data-key="{{item.key}}" bindtap="pickRole">
            <text class="role-option-icon">{{item.icon}}</text>
            <view class="grow">
                <text class="role-option-name">{{item.name}}</text>
                <text class="role-option-desc">{{item.desc}}</text>
            </view>
            <text wx:if="{{item.selected}}" class="role-option-check">✓</text>
        </view>
    </view>

    <!-- 课程详情：只读查看，编辑 / 删除需要用户再点一次 -->
    <course-detail visible="{{showCourseDetail}}" course="{{detailCourse}}" roleName="{{roleName}}"
                   bind:close="closeCourseDetail" bind:edit="editFromDetail" bind:remove="removeFromDetail" />
</view>
