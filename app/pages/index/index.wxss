.index-page {
    padding-bottom: 60rpx;
}

/* 示例 / 错误 / 加载 */
.demo-banner {
    display: flex;
    align-items: center;
    padding: 24rpx 28rpx;
    margin-bottom: 20rpx;
    background: #eaf1ff;
    border-radius: 20rpx;
}

.demo-banner-title {
    display: block;
    font-size: 28rpx;
    font-weight: 600;
    color: #1e55d6;
}

.demo-banner-desc {
    display: block;
    margin-top: 6rpx;
    font-size: 22rpx;
    color: #5a6478;
}

.demo-banner-action {
    font-size: 25rpx;
    color: #2f6bed;
    font-weight: 600;
}

.error-card {
    padding: 32rpx;
    margin-bottom: 20rpx;
    background: #fff3f1;
    border: 2rpx solid #ffd9d2;
    border-radius: 24rpx;
}

.error-title {
    display: block;
    font-size: 30rpx;
    font-weight: 600;
    color: #b94c37;
}

.error-desc {
    display: block;
    margin-top: 10rpx;
    font-size: 25rpx;
    color: #a4624f;
    line-height: 1.6;
}

.retry-btn {
    margin-top: 24rpx;
    width: 220rpx;
}

/* 头部 */
.header-card {
    background: #ffffff;
    border: 2rpx solid #e8ecf3;
    border-radius: 24rpx;
    padding: 24rpx;
    margin-bottom: 20rpx;
}

.header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.role-chip {
    display: flex;
    align-items: center;
    padding: 12rpx 20rpx;
    background: #eaf1ff;
    border-radius: 999rpx;
}

.role-icon {
    font-size: 26rpx;
    margin-right: 8rpx;
}

.role-name {
    font-size: 26rpx;
    font-weight: 600;
    color: #2f6bed;
}

.role-caret {
    font-size: 22rpx;
    color: #2f6bed;
    margin-left: 10rpx;
}

.header-seg {
    width: 260rpx;
    flex: none;
}

.week-nav {
    display: flex;
    align-items: center;
    margin-top: 24rpx;
}

.nav-arrow {
    width: 64rpx;
    height: 64rpx;
    line-height: 58rpx;
    text-align: center;
    border-radius: 18rpx;
    background: #f2f5fa;
    color: #5a6478;
    font-size: 40rpx;
    flex: none;
}

.week-mid {
    flex: 1;
    text-align: center;
    padding: 0 12rpx;
}

.week-label {
    display: block;
    font-size: 32rpx;
    font-weight: 700;
    color: #1b2437;
}

.week-range {
    display: block;
    margin-top: 4rpx;
    font-size: 22rpx;
    color: #8a94a6;
}

.parity-row {
    display: flex;
    align-items: center;
    margin-top: 22rpx;
    padding-top: 20rpx;
    border-top: 2rpx solid #e8ecf3;
}

.parity-label {
    font-size: 24rpx;
    color: #8a94a6;
    margin-right: 16rpx;
}

.parity-row .chip {
    margin-right: 14rpx;
}

/* 下一节课 */
.next-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28rpx 30rpx;
    margin-bottom: 20rpx;
    border-radius: 24rpx;
    background: linear-gradient(135deg, #2f6bed 0%, #5b8ff9 100%);
    color: #ffffff;
}

.next-left {
    flex: 1;
    min-width: 0;
}

.next-kicker {
    display: block;
    font-size: 22rpx;
    opacity: 0.85;
}

.next-title {
    display: block;
    margin-top: 8rpx;
    font-size: 36rpx;
    font-weight: 700;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.next-meta {
    display: block;
    margin-top: 8rpx;
    font-size: 24rpx;
    opacity: 0.9;
}

/* 老师 / 备注：有值才显示，单行省略，避免把蓝色卡片撑得过高 */
.next-extra {
    display: block;
    margin-top: 4rpx;
    font-size: 22rpx;
    opacity: 0.88;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.next-right {
    margin-left: 20rpx;
    flex: none;
}

.next-count {
    font-size: 24rpx;
    background: rgba(255, 255, 255, 0.2);
    padding: 10rpx 18rpx;
    border-radius: 999rpx;
}

/* 空态 */
.empty-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #ffffff;
    border: 2rpx solid #e8ecf3;
    border-radius: 24rpx;
    padding: 70rpx 32rpx;
    text-align: center;
}

.empty-btn {
    margin-top: 28rpx;
    width: 300rpx;
}

/* 周网格 */
.grid-card {
    display: flex;
    background: #ffffff;
    border: 2rpx solid #e8ecf3;
    border-radius: 24rpx;
    overflow: hidden;
}

.time-rail {
    width: 112rpx;
    flex: none;
    background: #fafbfe;
    border-right: 2rpx solid #e8ecf3;
}

.rail-head {
    height: 88rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22rpx;
    color: #8a94a6;
    border-bottom: 2rpx solid #e8ecf3;
}

.rail-row {
    height: 136rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-bottom: 2rpx solid #e8ecf3;
}

.rail-label {
    font-size: 21rpx;
    color: #5a6478;
    margin-bottom: 4rpx;
}

.rail-time {
    font-size: 19rpx;
    color: #8a94a6;
    line-height: 1.35;
}

.days-scroll {
    flex: 1;
    min-width: 0;
    white-space: nowrap;
}

.days-inner {
    display: inline-flex;
}

.day-col {
    display: inline-block;
    width: 208rpx;
    vertical-align: top;
    border-right: 2rpx solid #e8ecf3;
}

.day-head {
    height: 88rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-bottom: 2rpx solid #e8ecf3;
    background: #ffffff;
}

.day-head-today {
    background: #eaf1ff;
}

.day-name {
    font-size: 25rpx;
    font-weight: 600;
    color: #1b2437;
}

.day-head-today .day-name {
    color: #2f6bed;
}

.day-date {
    font-size: 20rpx;
    color: #8a94a6;
    margin-top: 2rpx;
}

.grid-cell {
    height: 136rpx;
    padding: 6rpx;
    border-bottom: 2rpx solid #e8ecf3;
    overflow: hidden;
}

.course-chip {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 6rpx 10rpx;
    margin-bottom: 6rpx;
    border-radius: 10rpx;
    overflow: hidden;
}

.chip-title {
    font-size: 22rpx;
    font-weight: 700;
    line-height: 1.3;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.chip-time {
    font-size: 18rpx;
    margin-top: 2rpx;
    opacity: 0.9;
}

.chip-place {
    font-size: 18rpx;
    margin-top: 2rpx;
    opacity: 0.8;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* 老师 + 备注合并成一行，单双周并入时间行，保证 136rpx 格子里不溢出 */
.chip-extra {
    font-size: 17rpx;
    margin-top: 2rpx;
    opacity: 0.78;
    line-height: 1.25;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* 批量勾选删除 */
.batch-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16rpx 20rpx;
    margin-bottom: 16rpx;
    background: #ffffff;
    border: 2rpx solid #e8ecf3;
    border-radius: 20rpx;
}

.batch-hint {
    font-size: 22rpx;
    color: #8a94a6;
}

.batch-entry {
    padding: 10rpx 24rpx;
    border-radius: 999rpx;
    background: #eaf1ff;
    color: #2f6bed;
    font-size: 24rpx;
    font-weight: 600;
}

.batch-count {
    font-size: 26rpx;
    font-weight: 600;
    color: #1b2437;
}

.batch-actions {
    display: flex;
    align-items: center;
}

.batch-link {
    font-size: 24rpx;
    color: #2f6bed;
    margin-right: 24rpx;
}

.batch-danger {
    padding: 10rpx 24rpx;
    border-radius: 999rpx;
    background: #fdeceb;
    color: #d95050;
    font-size: 24rpx;
    font-weight: 600;
}

.batch-disabled {
    opacity: 0.45;
}

.chip-check {
    position: absolute;
    top: 6rpx;
    right: 8rpx;
    width: 30rpx;
    height: 30rpx;
    border-radius: 50%;
    border: 2rpx solid #b6c2d6;
    background: rgba(255, 255, 255, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20rpx;
    color: #ffffff;
    z-index: 2;
}

.chip-check-on {
    background: #2f6bed;
    border-color: #2f6bed;
}

.course-chip-checked {
    box-shadow: inset 0 0 0 3rpx #2f6bed;
}

.grid-tip {
    display: block;
    margin-top: 16rpx;
    font-size: 22rpx;
    color: #8a94a6;
    text-align: center;
    line-height: 1.6;
}

/* 月视图 */
.month-card {
    background: #ffffff;
    border: 2rpx solid #e8ecf3;
    border-radius: 24rpx;
    padding: 24rpx 20rpx;
}

.month-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding-bottom: 20rpx;
}

.month-nav .nav-arrow {
    width: 56rpx;
    height: 56rpx;
    line-height: 50rpx;
    font-size: 34rpx;
}

.month-title {
    font-size: 32rpx;
    font-weight: 700;
    margin: 0 40rpx;
}

.month-today {
    position: absolute;
    right: 0;
    font-size: 24rpx;
    color: #2f6bed;
}

.month-heads {
    display: flex;
    border-bottom: 2rpx solid #e8ecf3;
    padding-bottom: 12rpx;
}

.month-head {
    flex: 1;
    text-align: center;
    font-size: 23rpx;
    color: #8a94a6;
}

.month-grid {
    display: flex;
    flex-wrap: wrap;
}

.month-cell {
    width: 14.2857%;
    height: 108rpx;
    padding: 8rpx 4rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    border-bottom: 2rpx solid #f2f4f8;
    border-right: 2rpx solid #f2f4f8;
}

.month-cell-out {
    opacity: 0.35;
}

.month-cell-today {
    background: #eaf1ff;
    border-radius: 12rpx;
}

.month-day {
    font-size: 26rpx;
    font-weight: 600;
    color: #1b2437;
}

.month-cell-today .month-day {
    color: #2f6bed;
}

.month-parity {
    font-size: 18rpx;
    color: #8a94a6;
    margin-top: 2rpx;
}

.month-dots {
    display: flex;
    margin-top: 6rpx;
    height: 10rpx;
}

.month-dot {
    width: 10rpx;
    height: 10rpx;
    border-radius: 50%;
    margin: 0 2rpx;
}

.month-count {
    font-size: 17rpx;
    color: #5a6478;
    margin-top: 2rpx;
}

.month-tip {
    display: block;
    margin-top: 18rpx;
    font-size: 22rpx;
    color: #8a94a6;
    text-align: center;
}

/* 悬浮新增按钮（位于原生 tabBar 上方） */
.fab {
    position: fixed;
    right: 32rpx;
    bottom: 40rpx;
    width: 96rpx;
    height: 96rpx;
    border-radius: 50%;
    background: #2f6bed;
    box-shadow: 0 10rpx 28rpx rgba(47, 107, 237, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 15;
}

.fab-text {
    color: #ffffff;
    font-size: 52rpx;
    line-height: 1;
    margin-top: -6rpx;
}

/* 底部抽屉 / 弹层 */
.sheet-mask {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background: rgba(20, 30, 50, 0.42);
    z-index: 30;
}

.day-sheet,
.role-sheet {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    max-height: 76vh;
    padding: 20rpx 28rpx;
    padding-bottom: calc(28rpx + constant(safe-area-inset-bottom));
    padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
    background: #ffffff;
    border-radius: 32rpx 32rpx 0 0;
    z-index: 31;
    display: flex;
    flex-direction: column;
}

.sheet-handle {
    width: 72rpx;
    height: 8rpx;
    border-radius: 8rpx;
    background: #dfe4ee;
    align-self: center;
    margin-bottom: 20rpx;
}

.sheet-close {
    font-size: 26rpx;
    color: #2f6bed;
}

.sheet-list {
    max-height: 56vh;
    margin-top: 16rpx;
}

.sheet-item {
    padding: 20rpx 22rpx;
    margin-bottom: 16rpx;
    background: #f8fafd;
    border-radius: 16rpx;
}

.sheet-title {
    font-size: 28rpx;
    font-weight: 600;
}

.sheet-time {
    font-size: 24rpx;
    color: #2f6bed;
}

.sheet-meta {
    display: block;
    margin-top: 6rpx;
    font-size: 23rpx;
    color: #5a6478;
}

.sheet-tag {
    margin-top: 12rpx;
}

.role-option {
    display: flex;
    align-items: center;
    padding: 24rpx;
    margin-top: 16rpx;
    background: #f8fafd;
    border: 2rpx solid transparent;
    border-radius: 20rpx;
}

.role-option-selected {
    border-color: #2f6bed;
    background: #eaf1ff;
}

.role-option-icon {
    font-size: 40rpx;
    margin-right: 22rpx;
}

.role-option-name {
    display: block;
    font-size: 29rpx;
    font-weight: 600;
}

.role-option-desc {
    display: block;
    margin-top: 4rpx;
    font-size: 23rpx;
    color: #8a94a6;
}

.role-option-check {
    font-size: 32rpx;
    color: #2f6bed;
    font-weight: 700;
}
