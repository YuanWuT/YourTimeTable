.grid-page {
    padding-top: 24rpx;
}

.error-card {
    padding: 24rpx 26rpx;
    margin-bottom: 20rpx;
    background: #fff3f1;
    border: 2rpx solid #ffd9d2;
    border-radius: 20rpx;
}

.error-desc {
    font-size: 26rpx;
    color: #b94c37;
    line-height: 1.6;
}

.retry-btn {
    margin-top: 18rpx;
    width: 180rpx;
}

.intro-actions {
    display: flex;
    margin-top: 20rpx;
}

.intro-actions button {
    flex: 1;
    margin: 0 8rpx;
    font-size: 24rpx;
}

.grid-card {
    display: flex;
    background: #ffffff;
    border: 2rpx solid #e8ecf3;
    border-radius: 24rpx;
    overflow: hidden;
}

.time-rail {
    width: 128rpx;
    flex: none;
    background: #f7f9fd;
}

.rail-head {
    height: 88rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22rpx;
    color: #8a94a6;
    border-bottom: 2rpx solid #e8ecf3;
}

.rail-row {
    height: 132rpx;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-left: 10rpx;
    border-bottom: 2rpx solid #e8ecf3;
}

.rail-label {
    font-size: 22rpx;
    color: #1b2437;
    font-weight: 600;
}

.rail-time {
    font-size: 20rpx;
    color: #8a94a6;
}

.days-scroll {
    flex: 1;
    min-width: 0;
    white-space: nowrap;
}

.days-inner {
    display: inline-flex;
}

.day-col {
    width: 190rpx;
    flex: none;
    border-left: 2rpx solid #e8ecf3;
}

.day-head {
    height: 88rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 2rpx solid #e8ecf3;
    font-size: 24rpx;
    font-weight: 600;
    color: #1b2437;
}

.grid-cell {
    height: 132rpx;
    border-bottom: 2rpx solid #e8ecf3;
    padding: 6rpx;
    box-sizing: border-box;
    overflow: hidden;
}

.batch-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16rpx 20rpx;
    margin-bottom: 16rpx;
    background: #ffffff;
    border: 2rpx solid #e8ecf3;
    border-radius: 20rpx;
}

.batch-hint {
    font-size: 22rpx;
    color: #8a94a6;
}

.batch-entry {
    padding: 10rpx 24rpx;
    border-radius: 999rpx;
    background: #eaf1ff;
    color: #2f6bed;
    font-size: 24rpx;
    font-weight: 600;
}

.batch-count {
    font-size: 26rpx;
    font-weight: 600;
    color: #1b2437;
}

.batch-actions {
    display: flex;
    align-items: center;
}

.batch-link {
    font-size: 24rpx;
    color: #2f6bed;
    margin-right: 24rpx;
}

.batch-danger {
    padding: 10rpx 24rpx;
    border-radius: 999rpx;
    background: #fdeceb;
    color: #d95050;
    font-size: 24rpx;
    font-weight: 600;
}

.batch-disabled {
    opacity: 0.45;
}

/* 批量模式的星期快捷跳转 */
.day-tabs-scroll {
    white-space: nowrap;
    margin-bottom: 16rpx;
}

.day-tabs {
    display: inline-flex;
    padding: 8rpx;
    background: #ffffff;
    border: 2rpx solid #e8ecf3;
    border-radius: 20rpx;
}

.day-tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 92rpx;
    padding: 10rpx 14rpx;
    margin-right: 8rpx;
    border-radius: 14rpx;
    background: #f2f5fa;
}

.day-tab:last-child {
    margin-right: 0;
}

.day-tab-name {
    font-size: 23rpx;
    font-weight: 600;
    color: #2f6bed;
}

.day-tab-count {
    font-size: 19rpx;
    color: #8a94a6;
    margin-top: 2rpx;
}

.chip-check {
    position: absolute;
    top: 6rpx;
    right: 8rpx;
    width: 30rpx;
    height: 30rpx;
    border-radius: 50%;
    border: 2rpx solid #b6c2d6;
    background: rgba(255, 255, 255, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20rpx;
    color: #ffffff;
    z-index: 2;
}

.chip-check-on {
    background: #2f6bed;
    border-color: #2f6bed;
}

.course-chip-checked {
    box-shadow: inset 0 0 0 3rpx #2f6bed;
}

.course-chip {
    position: relative;
    display: block;
    padding: 6rpx 8rpx;
    margin-bottom: 4rpx;
    border-radius: 8rpx;
    overflow: hidden;
}

.chip-title {
    display: block;
    font-size: 22rpx;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.chip-time {
    display: block;
    font-size: 18rpx;
    opacity: 0.8;
}

/* 老师 + 备注合并成一行，超长省略 */
.chip-extra {
    display: block;
    font-size: 17rpx;
    margin-top: 2rpx;
    opacity: 0.78;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.cell-add {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #c6cede;
    font-size: 36rpx;
}

.grid-tip {
    padding: 20rpx 8rpx 160rpx;
    font-size: 22rpx;
    color: #8a94a6;
    text-align: center;
}

.fab {
    position: fixed;
    right: 36rpx;
    bottom: calc(48rpx + env(safe-area-inset-bottom));
    width: 96rpx;
    height: 96rpx;
    border-radius: 50%;
    background: #2f6bed;
    box-shadow: 0 8rpx 24rpx rgba(47, 107, 237, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 15;
}

.fab-text {
    color: #ffffff;
    font-size: 48rpx;
    line-height: 1;
}
