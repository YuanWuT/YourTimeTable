<view class="page page-safe grid-page">
    <block wx:if="{{authState === 'checking' || loading}}">
        <view class="loading-box">
            <view class="spinner"></view>
            <text class="empty-desc">正在加载课表网格…</text>
        </view>
    </block>

    <block wx:elif="{{authState === 'signed-out'}}">
        <login-panel title="登录后录入课程" bind:signedin="onRetry" bind:demo="onDemo" />
    </block>

    <block wx:else>
        <view wx:if="{{errorText}}" class="error-card">
            <text class="error-desc">{{errorText}}</text>
            <button class="plain-btn retry-btn" bindtap="onRetry">重新加载</button>
        </view>

        <view class="card">
            <text class="section-title">点格子录入 · {{roleName}}课表</text>
            <text class="section-sub">点空格子添加课程，点已有课程可编辑或删除；每个身份有自己独立的课表</text>
            <view class="intro-actions">
                <button class="ghost-btn" bindtap="goRecycle">已删除的课程 {{deletedCount}}</button>
                <button class="ghost-btn" bindtap="goSettings">作息节次</button>
            </view>
        </view>

        <view class="batch-bar">
            <block wx:if="{{!batchMode}}">
                <text class="batch-hint">长按课程卡片可批量勾选</text>
                <view class="batch-entry" bindtap="toggleBatchMode">批量删除</view>
            </block>
            <block wx:else>
                <text class="batch-count">已选 {{selectedCount}} 节</text>
                <view class="batch-actions">
                    <text class="batch-link" bindtap="selectAllBatch">全选</text>
                    <text class="batch-link" bindtap="exitBatchMode">取消</text>
                    <text class="batch-danger {{selectedCount === 0 ? 'batch-disabled' : ''}}"
                          bindtap="confirmBatchRemove">删除选中</text>
                </view>
            </block>
        </view>

        <scroll-view wx:if="{{batchMode}}" class="day-tabs-scroll" scroll-x="true">
            <view class="day-tabs">
                <view wx:for="{{dayTabs}}" wx:key="index" class="day-tab"
                      data-index="{{item.index}}" bindtap="jumpToDay">
                    <text class="day-tab-name">{{item.name}}</text>
                    <text class="day-tab-count">{{item.count}} 节</text>
                </view>
            </view>
        </scroll-view>

        <view class="grid-card">
            <view class="time-rail">
                <view class="rail-head"><text>节次</text></view>
                <view wx:for="{{timeRail}}" wx:key="sort_no" class="rail-row">
                    <text class="rail-label">{{item.label}}</text>
                    <text class="rail-time">{{item.start_time}}</text>
                    <text class="rail-time">{{item.end_time}}</text>
                </view>
            </view>
            <scroll-view class="days-scroll" scroll-x="true" scroll-into-view="{{scrollIntoId}}">
                <view class="days-inner">
                    <view wx:for="{{columns}}" wx:key="key" id="{{item.id}}" class="day-col">
                        <view class="day-head"><text class="day-name">{{item.dayName}}</text></view>
                        <view wx:for="{{item.cells}}" wx:for-item="cell" wx:key="key" class="grid-cell"
                              data-day="{{cell.day}}" data-period="{{cell.periodNo}}" bindtap="onCellTap">
                            <block wx:if="{{cell.courses.length > 0}}">
                                <view wx:for="{{cell.courses}}" wx:for-item="course" wx:key="id"
                                      class="course-chip {{course.checked ? 'course-chip-checked' : ''}}"
                                      style="background:{{course.bg}};color:{{course.fg}};border-left:6rpx solid {{course.solid}}"
                                      data-id="{{course.id}}" catchtap="onCourseTap" bindlongpress="onCourseLongPress">
                                    <view wx:if="{{batchMode}}" class="chip-check {{course.checked ? 'chip-check-on' : ''}}">
                                        <text wx:if="{{course.checked}}">✓</text>
                                    </view>
                                    <text class="chip-title">{{course.title}}</text>
                                    <text class="chip-time">{{course.chipTimeText}}</text>
                                    <text wx:if="{{course.chipExtraText}}" class="chip-extra">{{course.chipExtraText}}</text>
                                </view>
                            </block>
                            <view wx:else class="cell-add"><text>＋</text></view>
                        </view>
                    </view>
                </view>
            </scroll-view>
        </view>

        <view class="grid-tip">{{batchMode ? '点卡片勾选或取消 · 点上方星期可直接跳到那一天' : '共 ' + courseCount + ' 节课 · 点空格子添加、长按课程批量管理'}}</view>
        <view wx:if="{{!batchMode}}" class="fab" bindtap="onAddFree"><text class="fab-text">＋</text></view>
    </block>

    <!-- 课程详情：只读查看，编辑 / 删除需要用户再点一次 -->
    <course-detail visible="{{showCourseDetail}}" course="{{detailCourse}}" roleName="{{roleName}}"
                   bind:close="closeCourseDetail" bind:edit="editFromDetail" bind:remove="removeFromDetail" />
</view>
