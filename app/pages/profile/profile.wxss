.profile-page {
    padding-top: 28rpx;
}

.error-card {
    padding: 24rpx 26rpx;
    margin-bottom: 20rpx;
    background: #fff3f1;
    border: 2rpx solid #ffd9d2;
    border-radius: 20rpx;
}

.error-desc {
    font-size: 26rpx;
    color: #b94c37;
}

.retry-btn {
    margin-top: 18rpx;
    width: 200rpx;
}

.profile-card {
    display: flex;
    align-items: center;
    padding: 36rpx 30rpx;
    margin-bottom: 20rpx;
    border-radius: 28rpx;
    background: linear-gradient(135deg, #2f6bed 0%, #6a9bff 100%);
}

.avatar {
    width: 104rpx;
    height: 104rpx;
    flex: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 24rpx;
    overflow: hidden;
}

.avatar-img {
    width: 104rpx;
    height: 104rpx;
}

.avatar-text {
    font-size: 44rpx;
    font-weight: 700;
    color: #ffffff;
}

.profile-info {
    min-width: 0;
}

.profile-name {
    display: block;
    font-size: 34rpx;
    font-weight: 700;
    color: #ffffff;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.profile-sync {
    display: block;
    margin-top: 8rpx;
    font-size: 22rpx;
    color: rgba(255, 255, 255, 0.85);
}

.profile-badge {
    flex: none;
    font-size: 20rpx;
    color: #ffffff;
    background: rgba(255, 255, 255, 0.22);
    padding: 8rpx 16rpx;
    border-radius: 999rpx;
    margin-left: 12rpx;
}

.stats-card {
    display: flex;
    background: #ffffff;
    border: 2rpx solid #e8ecf3;
    border-radius: 24rpx;
    padding: 28rpx 0;
    margin-bottom: 20rpx;
}

.stat-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    border-right: 2rpx solid #e8ecf3;
}

.stat-item:last-child {
    border-right: none;
}

.stat-number {
    font-size: 40rpx;
    font-weight: 700;
    color: #2f6bed;
}

.stat-label {
    font-size: 22rpx;
    color: #8a94a6;
    margin-top: 6rpx;
}

.role-current {
    display: flex;
    align-items: center;
    margin: 20rpx 0 12rpx;
}

.role-current-icon {
    font-size: 44rpx;
    margin-right: 20rpx;
}

.role-current-name {
    display: block;
    font-size: 30rpx;
    font-weight: 600;
}

.role-current-desc {
    display: block;
    margin-top: 4rpx;
    font-size: 23rpx;
    color: #8a94a6;
}

.role-switch {
    font-size: 25rpx;
    color: #2f6bed;
}

.menu-card {
    padding: 8rpx 28rpx;
}

.menu-item {
    display: flex;
    align-items: center;
    padding: 26rpx 0;
    border-bottom: 2rpx solid #e8ecf3;
    font-size: 27rpx;
}

.menu-item:last-child {
    border-bottom: none;
}

.menu-icon {
    font-size: 32rpx;
    margin-right: 20rpx;
}

.menu-arrow {
    font-size: 36rpx;
    color: #c3cad7;
}

.about-card .section-sub {
    margin-top: 12rpx;
}

.signout-btn {
    margin-top: 8rpx;
    height: 88rpx;
    line-height: 88rpx;
}

.sheet-mask {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background: rgba(20, 30, 50, 0.42);
    z-index: 30;
}

.role-sheet {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 20rpx 28rpx;
    padding-bottom: calc(28rpx + constant(safe-area-inset-bottom));
    padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
    background: #ffffff;
    border-radius: 32rpx 32rpx 0 0;
    z-index: 31;
}

.sheet-handle {
    width: 72rpx;
    height: 8rpx;
    border-radius: 8rpx;
    background: #dfe4ee;
    align-self: center;
    margin: 0 auto 20rpx;
}

.role-option {
    display: flex;
    align-items: center;
    padding: 24rpx;
    margin-top: 16rpx;
    background: #f8fafd;
    border: 2rpx solid transparent;
    border-radius: 20rpx;
}

.role-option-selected {
    border-color: #2f6bed;
    background: #eaf1ff;
}

.role-option-icon {
    font-size: 40rpx;
    margin-right: 22rpx;
}

.role-option-name {
    display: block;
    font-size: 29rpx;
    font-weight: 600;
}

.role-option-desc {
    display: block;
    margin-top: 4rpx;
    font-size: 23rpx;
    color: #8a94a6;
}

.role-option-check {
    font-size: 32rpx;
    color: #2f6bed;
    font-weight: 700;
}
