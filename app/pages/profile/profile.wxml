<view class="page page-safe profile-page">
    <block wx:if="{{authState === 'checking' || loading}}">
        <view class="loading-box">
            <view class="spinner"></view>
            <text class="empty-desc">正在加载个人资料…</text>
        </view>
    </block>

    <block wx:elif="{{authState === 'signed-out'}}">
        <login-panel title="登录你的课程表" bind:signedin="onSignedIn" bind:demo="onDemo" />
    </block>

    <block wx:else>
        <view wx:if="{{errorText}}" class="error-card">
            <text class="error-desc">{{errorText}}</text>
            <button class="plain-btn retry-btn" bindtap="onRetry">重新加载</button>
        </view>

        <view class="profile-card">
            <view class="avatar">
                <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
                <text wx:else class="avatar-text">{{initial}}</text>
            </view>
            <view class="grow profile-info">
                <text class="profile-name">{{displayName}}</text>
                <text class="profile-sync">已通过微信登录 · 课表保存在云端</text>
            </view>
            <text class="profile-badge">已同步</text>
        </view>

        <view class="stats-card">
            <view class="stat-item" data-key="courses" bindtap="onStatTap" hover-class="stat-item-hover">
                <text class="stat-number">{{courseCount}}</text>
                <text class="stat-label">课程</text>
                <text class="stat-more">查看 ›</text>
            </view>
            <view class="stat-item" data-key="periods" bindtap="onStatTap" hover-class="stat-item-hover">
                <text class="stat-number">{{periodCount}}</text>
                <text class="stat-label">作息节次</text>
                <text class="stat-more">查看 ›</text>
            </view>
            <view class="stat-item" data-key="imports" bindtap="onStatTap" hover-class="stat-item-hover">
                <text class="stat-number">{{importCount}}</text>
                <text class="stat-label">导入记录</text>
                <text class="stat-more">查看 ›</text>
            </view>
        </view>

        <view class="card role-card" bindtap="openRolePicker">
            <text class="section-title">当前使用身份</text>
            <view class="role-current">
                <text class="role-current-icon">{{roleIcon}}</text>
                <view class="grow">
                    <text class="role-current-name">{{roleName}}</text>
                    <text class="role-current-desc">{{roleDesc}}</text>
                </view>
                <text class="role-switch">切换 ›</text>
            </view>
            <text class="section-sub">学生 / 家长 / 老师各有一份独立课表，切换后自动加载；身份保存在云端</text>
        </view>

        <view class="card menu-card">
            <view class="menu-item" bindtap="goSettings">
                <text class="menu-icon">⏰</text>
                <text class="grow">作息节次调整、开学日期及提醒</text>
                <text class="menu-arrow">›</text>
            </view>
            <view class="menu-item" bindtap="goImport">
                <text class="menu-icon">📥</text>
                <text class="grow">录入课程表</text>
                <text class="menu-arrow">›</text>
            </view>
            <view class="menu-item" bindtap="goRecycle">
                <text class="menu-icon">♻️</text>
                <text class="grow">已删除的课程（可恢复）</text>
                <text class="menu-arrow">›</text>
            </view>
        </view>

        <view class="card about-card">
            <text class="section-title">关于「你的课程表」</text>
            <text class="section-sub">支持周一到周日、单双周、月视图，手动录入、拍照识别与 Excel 导入。数据按微信登录身份保存在云端，换手机登录后课表自动恢复。</text>
        </view>

        <button class="plain-btn signout-btn" loading="{{signOutBusy}}" disabled="{{signOutBusy}}" bindtap="signOut">退出登录</button>
    </block>

    <view wx:if="{{showRolePicker}}" class="sheet-mask" bindtap="closeRolePicker"></view>
    <view wx:if="{{showRolePicker}}" class="role-sheet" catchtap="noop">
        <view class="sheet-handle"></view>
        <text class="section-title">切换使用身份</text>
        <text class="section-sub">身份保存在云端，换手机登录后保持不变</text>
        <view wx:for="{{roleOptions}}" wx:key="key" class="role-option {{item.selected ? 'role-option-selected' : ''}}"
              data-key="{{item.key}}" bindtap="pickRole">
            <text class="role-option-icon">{{item.icon}}</text>
            <view class="grow">
                <text class="role-option-name">{{item.name}}</text>
                <text class="role-option-desc">{{item.desc}}</text>
            </view>
            <text wx:if="{{item.selected}}" class="role-option-check">✓</text>
        </view>
    </view>
</view>
